{
  "schemaVersion": 1,
  "gdsVersion": "2.6.7",
  "productArchetype": "hybrid",
  "supportedEntryPoints": [
    "@doneisbetter/gds-theme/client",
    "@doneisbetter/gds-theme/server",
    "@doneisbetter/gds-core/client",
    "@doneisbetter/gds-core/server",
    "@doneisbetter/gds-admin/client"
  ],
  "requiredContracts": [
    "AppShell",
    "PageHeader",
    "StateBlock",
    "PublicShell"
  ],
  "localAdapters": [
    {
      "contract": "PublicShell",
      "path": "src/ui/PublicShell.tsx",
      "status": "active"
    }
  ],
  "approvedExceptions": [
    {
      "surface": "Map embed",
      "category": "package-coverage-gap",
      "scope": [
        "src/features/venues/components/VenueMap.tsx"
      ],
      "reason": "Third-party map engine remains outside canonical GDS scope.",
      "allowedImplementation": [
        "MapPanel with a sanctioned iframe or map-runtime slot"
      ],
      "mustStillUse": [
        "GDS spacing tokens",
        "GDS accessibility labels",
        "GDS loading, empty, and error states"
      ],
      "mustNotDo": [
        "Create a local replacement shell",
        "Bypass accessibility labeling",
        "Use free-form raw layout CSS as a parallel design system"
      ],
      "a11yRequirements": [
        "Keyboard reachable fallback actions",
        "Accessible title for the embedded runtime"
      ],
      "testingRequirements": [
        "Empty and provider-error states covered in component tests"
      ],
      "observabilityRequirements": [
        "Recoverable provider failures visible to operators"
      ],
      "owner": "platform-ui",
      "reviewDate": "2026-05-27",
      "exitCondition": "Replace with the canonical GDS primitive once the package line covers this surface directly.",
      "status": "temporary"
    },
    {
      "surface": "Approved icon exception",
      "category": "migration-bridge",
      "scope": [
        "src/icons/legacy/*.tsx"
      ],
      "dependency": "lucide-react",
      "allowImports": ["lucide-react"],
      "reason": "Consumer keeps a reviewed icon exception while remaining on shared lint/gds-compliance tooling.",
      "allowedImplementation": [
        "Imports confined to the reviewed bridge layer"
      ],
      "mustStillUse": [
        "GDS action semantics",
        "GDS spacing and color tokens"
      ],
      "mustNotDo": [
        "Spread lucide-react imports into feature UI",
        "Use the bridge as a permanent icon policy"
      ],
      "owner": "platform-ui",
      "reviewDate": "2026-05-27",
      "exitCondition": "Remove once the consumer has finished the icon migration to the canonical GDS vocabulary.",
      "status": "temporary"
    },
    {
      "surface": "Creator-authored campaign canvas",
      "category": "product-authored-experience",
      "scope": [
        "src/features/campaigns/creator-canvas/*.tsx",
        "src/features/campaigns/creator-canvas/*.css.ts"
      ],
      "reason": "A bounded creator-owned campaign surface temporarily retains product-local presentation overrides.",
      "allowedImplementation": [
        "Creator-authored CSS scoped to the approved canvas root only"
      ],
      "mustStillUse": [
        "GDS public shell",
        "GDS shared consent and legal controls",
        "GDS state and recovery surfaces outside the canvas"
      ],
      "mustNotDo": [
        "Replace shared app chrome",
        "Hide required consent controls",
        "Apply creator CSS outside the approved canvas scope"
      ],
      "a11yRequirements": [
        "Shared controls remain keyboard accessible and labeled",
        "Critical text and consent surfaces preserve contrast and readability"
      ],
      "testingRequirements": [
        "Base fallback presentation covered when creator styles fail to load",
        "Mobile layout and shared control visibility covered in route verification"
      ],
      "observabilityRequirements": [
        "Broken or malformed override payloads are visible to operators",
        "Moderation and publish workflows can identify the themed canvas owner"
      ],
      "owner": "platform-ui",
      "reviewDate": "2026-05-28",
      "exitCondition": "Replace once the shared creator-authored experience theming lane covers this use case directly.",
      "status": "temporary"
    }
  ],
  "compliance": {
    "documentationPaths": [
      "README.md",
      "docs/design-system-adapter.md"
    ],
    "staleDocumentationReferences": [
      "MANTINE_RUNTIME.md",
      "COMPONENT_CONTRACTS.md",
      "MANTINE_PLATFORM.md"
