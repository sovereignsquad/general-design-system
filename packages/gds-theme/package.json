{
  "name": "@sovereignsquad/gds-theme",
  "version": "4.1.8",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "gds-theme-tokens": "bin/gds-theme-tokens.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignsquad/general-design-system.git",
    "directory": "packages/gds-theme"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./dates.css": "./dates.css",
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "styles.css",
    "dates.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@mantine/core": "^7.9.0 || ^8.3.0 || ^9.0.0",
    "@mantine/hooks": "^7.9.0 || ^8.3.0 || ^9.0.0",
    "@mantine/modals": "^7.9.0 || ^8.3.0 || ^9.0.0",
    "@mantine/notifications": "^7.9.0 || ^8.3.0 || ^9.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@mantine/core": "^7.9.0",
    "@mantine/hooks": "^7.9.0",
    "@mantine/modals": "^7.9.0",
    "@mantine/notifications": "^7.9.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
